# Base image: CUDA 12.9.1 + cuDNN on Ubuntu 24.04
FROM nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04

SHELL ["/bin/bash", "-lc"]

ARG DEBIAN_FRONTEND=noninteractive

# ---------- System utilities ----------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        wget \
        zip \
        unzip \
        vim \
        ca-certificates \
        openssh-server \
        locales \
        tzdata && \
    rm -rf /var/lib/apt/lists/*

# ---------- SSH configuration ----------
RUN mkdir -p /var/run/sshd && \
    sed -ri 's/^#?PermitRootLogin\s+.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    (cat /etc/ssh/ssh_config | grep -v StrictHostKeyChecking || true) > /etc/ssh/ssh_config.new && \
    echo "    StrictHostKeyChecking no" >> /etc/ssh/ssh_config.new && \
    mv /etc/ssh/ssh_config.new /etc/ssh/ssh_config

# ---------- Locale & timezone (UK) ----------
RUN locale-gen en_GB en_GB.UTF-8 && \
    update-locale LANG=en_GB.UTF-8 && \
    echo "LANG=en_GB.UTF-8" >> /etc/profile && \
    echo "LANGUAGE=en_GB:en" >> /etc/profile && \
    echo "LC_ALL=en_GB.UTF-8" >> /etc/profile && \
    ln -sf /usr/share/zoneinfo/Europe/London /etc/localtime && \
    echo 'Europe/London' > /etc/timezone

# ---------- Install Miniforge (conda-forge only) ----------
ENV CONDA_DIR=/opt/conda
ENV PATH=$CONDA_DIR/bin:$PATH

ARG MINIFORGE_VERSION=25.3.1-0
RUN curl -fsSL -o /tmp/miniforge.sh \
      https://github.com/conda-forge/miniforge/releases/download/${MINIFORGE_VERSION}/Miniforge3-Linux-x86_64.sh \
 && bash /tmp/miniforge.sh -b -p $CONDA_DIR \
 && rm /tmp/miniforge.sh \
 && conda config --add channels conda-forge \
 && conda config --set channel_priority strict \
 && conda config --set auto_activate_base false \
 && conda clean -afy

# Create env from conda-forge only
RUN conda create -y -n py312 python=3.12 \
 && conda clean -afy

ENV PATH=$CONDA_DIR/envs/py312/bin:$PATH

# ---------- Python / Jupyter setup ----------
# Install JupyterLab, widgets, zh_CN pack, matplotlib, h5py via pip
# ipympl via conda for full compatibility
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
        "jupyterlab>=4.0.0" \
        ipywidgets \
        matplotlib \
        h5py \
        jupyterlab_language_pack_zh_CN && \
    conda install -y -c conda-forge ipympl && \
    conda clean -afy

# ---------- PyTorch (CUDA 12.9) ----------
RUN pip install --no-cache-dir \
    torch==2.8.0 \
    torchvision==0.23.0 \
    torchaudio==2.8.0 \
    --index-url https://download.pytorch.org/whl/cu129
