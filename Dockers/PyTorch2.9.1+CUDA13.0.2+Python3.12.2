# Base image: CUDA 13.0.2 + cuDNN on Ubuntu 24.04
FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

SHELL ["/bin/bash", "-lc"]

ARG DEBIAN_FRONTEND=noninteractive

# ---------- System utilities ----------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        wget \
        zip \
        unzip \
        vim \
        ca-certificates \
        openssh-server \
        locales \
        tzdata && \
    rm -rf /var/lib/apt/lists/*

# ---------- SSH configuration ----------
RUN mkdir -p /var/run/sshd && \
    sed -ri 's/^#?PermitRootLogin\s+.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    (cat /etc/ssh/ssh_config | grep -v StrictHostKeyChecking || true) > /etc/ssh/ssh_config.new && \
    echo "    StrictHostKeyChecking no" >> /etc/ssh/ssh_config.new && \
    mv /etc/ssh/ssh_config.new /etc/ssh/ssh_config

# ---------- Locale & timezone (UK) ----------
RUN locale-gen en_GB en_GB.UTF-8 && \
    update-locale LANG=en_GB.UTF-8 && \
    echo "LANG=en_GB.UTF-8" >> /etc/profile && \
    echo "LANGUAGE=en_GB:en" >> /etc/profile && \
    echo "LC_ALL=en_GB.UTF-8" >> /etc/profile && \
    ln -sf /usr/share/zoneinfo/Europe/London /etc/localtime && \
    echo 'Europe/London' > /etc/timezone

# ---------- Install Miniconda (Python 3.12.?) ----------
RUN cd /root && \
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-py312_25.9.1-3-Linux-x86_64.sh && \
    bash ./Miniconda3-py312_25.9.1-3-Linux-x86_64.sh -b -f -p /root/miniconda3 && \
    rm -f ./Miniconda3-py312_25.9.1-3-Linux-x86_64.sh && \
    echo "PATH=/root/miniconda3/bin:/usr/local/bin:\$PATH" >> /etc/profile && \
    echo "source /etc/profile" >> /root/.bashrc && \
    echo "source /etc/autodl-motd" >> /root/.bashrc
ENV PATH="/root/miniconda3/bin:/usr/local/bin:${PATH}"

# ---------- Python / Jupyter setup ----------
RUN conda config --remove-key channels || true && \
    conda config --add channels conda-forge && \
    conda config --set channel_priority strict && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --root-user-action=ignore \
        "jupyterlab>=4.0.0" \
        ipywidgets \
        matplotlib \
        h5py \
        jupyterlab_language_pack_zh_CN && \
    conda install -y ipympl && \
    conda clean -afy

# ---------- PyTorch (CUDA 13.0) ----------
RUN pip install --no-cache-dir \
    torch torchvision \
    --index-url https://download.pytorch.org/whl/cu130
